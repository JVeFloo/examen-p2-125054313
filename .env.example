# ------------------------------------------------------------
# Copia este archivo antes de levantar el proyecto:
#     cp .env.example .env
# El archivo .env NO se sube al repositorio (esta en .gitignore).
# ------------------------------------------------------------

# Matricula de 9 digitos (define el nombre del CSV y la semilla)
MATRICULA=125054313

# Credenciales de PostgreSQL
POSTGRES_USER=datamart
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=ventas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Puerto en el que se publica la API en el host
API_PORT=8000
